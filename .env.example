# OneEntry CMS API origin. This is the *CMS*, NOT the site — never use it for
# canonical URLs, sitemap entries or metadataBase (see app/utils/getSiteUrl.ts).
NEXT_PUBLIC_PROJECT_URL=https://oneentry.your-project.url
NEXT_PUBLIC_APP_TOKEN=xxxxx...xxxxx...xxxxx

# Canonical origin of THIS site — feeds canonical links, hreflang alternates,
# JSON-LD, sitemap.xml, robots.txt and llms.txt. Set it in production: without
# it those URLs fall back to NEXT_PUBLIC_VERCEL_URL, then to Vercel's injected
# host, then to http://localhost:3000 (which is what leaked into the deployed
# canonical tags before).
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

NEXT_PUBLIC_VERCEL_URL="https://your-project.vercel.app/"

# --- Google OAuth (provider marker: google_web) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx-xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxx

# Origin only (no path). The callback route is `${NEXT_PUBLIC_APP_URL}/<lang>/auth/callback/google`.
NEXT_PUBLIC_APP_URL=http://localhost:3545