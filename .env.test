# Loaded by next/jest when NODE_ENV=test. Next deliberately skips .env.local in
# the test environment, so without this file the Jest suites that import
# app/api/api/api.ts die on its fail-fast env guard before a single test runs.
#
# Placeholders on purpose: the Jest suites are unit tests (pure guards, hooks
# with a mocked SDK) and never reach the CMS — they only need the guard to pass.
# Real credentials stay in .env.local, which serves dev/build.
NEXT_PUBLIC_PROJECT_URL=https://example.oneentry.cloud
NEXT_PUBLIC_APP_TOKEN=test-app-token
