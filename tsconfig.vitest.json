{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react",
    "allowImportingTsExtensions": false,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
