{
  "mcpServers": {
    "oneentry": {
      "command": "npx",
      "args": ["-y", "@oneentry/mcp-server@latest"],
      "env": {
        "ONEENTRY_URL": "https://your-project-url.oneentry.cloud",
        "ONEENTRY_TOKEN": "your-project-app-token"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    }
  }
}